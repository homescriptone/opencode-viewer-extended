{
  "name": "@homescriptone/opencode-viewer-extender",
  "version": "1.1.0",
  "description": "Local GUI to browse, edit, and export your OpenCode sessions, messages, and tool calls from the SQLite database, with a plugin API",
  "bin": {
    "opencode-viewer": "bin/cli.js"
  },
  "files": [
    "bin/",
    "public/",
    "server/"
  ],
  "scripts": {
    "dev": "bun run --watch server/launch.ts",
    "start": "bun run server/launch.ts",
    "typecheck": "bun check",
    "prepublishOnly": "bun check",
    "deploy": "npm version patch --no-git-tag-version && git add -A && git commit -m \"v$(node -p require('./package.json').version)\" && git push && npm publish --access public"
  },
  "keywords": [
    "opencode",
    "opencode-viewer",
    "viewer",
    "sqlite",
    "sessions",
    "ai",
    "cli",
    "bun",
    "plugins"
  ],
  "author": "homescriptone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homescriptone/opencode-viewer-extended.git"
  },
  "homepage": "https://homescriptone.github.io/opencode-viewer-extended/",
  "bugs": {
    "url": "https://github.com/homescriptone/opencode-viewer-extended/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5"
  }
}
