{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Viewer",
  "version": "1.3.0",
  "identifier": "com.homescriptone.opencode-viewer-extender",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode Viewer",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ocv-server"],
    "category": "DeveloperTool",
    "shortDescription": "Browse, edit, and export OpenCode sessions",
    "longDescription": "A local GUI to browse, edit, and export your OpenCode sessions, messages, and tool calls from the SQLite database."
  }
}
